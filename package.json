{
  "name": "harpoon",
  "productName": "Harpoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive hexagonal architecture diagrams for documenting, planning and presenting systems, with Claude Code and Codex built in.",
  "license": "MIT",
  "author": {
    "name": "The Harpoon authors"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.viewer.config.ts",
    "start": "electron-vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "package:dir": "pnpm build && electron-builder --dir",
    "package": "pnpm build && electron-builder",
    "icons": "node scripts/make-icons.mjs",
    "fake-cli": "node scripts/build-fake-cli.mjs",
    "cli": "node src/cli/harpoon.ts",
    "e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.289",
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.52.0",
    "prettier": "^3.9.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.19.0",
    "@codemirror/commands": "6.9.0",
    "@codemirror/lang-markdown": "6.3.4",
    "@codemirror/language": "6.11.3",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "elkjs": "0.12.0"
  }
}
